# --- PostgreSQL (docker compose up -d db). Driver: asyncpg ---
DATABASE_URL=postgresql://upay:upay@localhost:5434/upay_pulse

# --- LLM (Google Gemini via LangChain) ---
GOOGLE_API_KEY=your_key_here
# "gemini-flash-latest" always points to the newest Flash model.
# Pin a specific one if you prefer, e.g. gemini-3.5-flash or gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest

# --- Synthetic data / modelling (defaults shown) ---
N_AGENTS=300
START_DATE=2025-05-01
END_DATE=2026-06-30
TEST_DAYS=60
VAL_DAYS=30
TRAIN_SAMPLE_FRAC=0.5
DEMO_AS_OF=2026-05-20 08:00


AUTO_MIGRATE=false

JWT_SECRET=your-long-random-secret
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000