# URL of the FastAPI backend. Used ONLY on the server, so it is never sent to the browser.
API_BASE_URL=http://127.0.0.1:8000

# Set to "true" when the site runs on HTTPS, so the login cookies are marked Secure.
COOKIE_SECURE=false

# How many days the refresh cookie lives (match REFRESH_TOKEN_DAYS in the backend).
SESSION_DAYS=7

# Shows three "demo account" buttons on the login page (development only).
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

# Map background. Leave empty for the default light CARTO style.
# Use "blank" for an offline plain background (hexagons still show).
NEXT_PUBLIC_MAP_STYLE=
